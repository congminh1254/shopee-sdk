  "define": {
    "content": "<p>Get the details of an SSP or CSSP. At least one of ssp_id and cssp_id is required, and cssp_id takes priority when both are provided.</p><p>The response covers the product content such as the category path, attributes, brand and variations. Each entry in cssps is a country-specific SSP under the SSP, and its tier_indices point to the selected options of the parent tier_variation.</p>",
    "raw_content": [
      {
        "name": "paragraph",
        "children": [
          {
            "data": "Get the details of an SSP or CSSP. At least one of ssp_id and cssp_id is required, and cssp_id takes priority when both are provided."
          }
        ]
      },
      {
        "name": "paragraph",
        "children": [
          {
            "data": "The response covers the product content such as the category path, attributes, brand and variations. Each entry in cssps is a country-specific SSP under the SSP, and its tier_indices point to the selected options of the parent tier_variation."
          }
        ]
      }
    ]
  },
