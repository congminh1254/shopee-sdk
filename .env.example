# Shopee SDK Sandbox Integration Test Credentials
# Copy this file to '.env' and fill in your Shopee Open Platform Sandbox credentials.

# Your Shopee Open Platform Sandbox Partner Credentials
SHOPEE_SANDBOX_PARTNER_ID=your_sandbox_partner_id_here
SHOPEE_SANDBOX_PARTNER_KEY=your_sandbox_partner_key_here

# Your Shopee Sandbox Shop ID (Vietnam Local)
SHOPEE_SANDBOX_SHOP_ID=your_sandbox_shop_id_here

# Your Sandbox Seller Center / Shop Login Credentials (for Vietnam Local Sandbox)
# Required by the shop suite: npm run test:sandbox:shop
SHOPEE_SANDBOX_ACCOUNT=your_sandbox_seller_username_or_email_here
SHOPEE_SANDBOX_PASSWORD=your_sandbox_seller_password_here

# Sandbox main account (same app) for the user and merchant suites:
# npm run test:sandbox:user / test:sandbox:merchant.
# The sandbox accepts any OTP (default 123456, override with SHOPEE_SANDBOX_MAIN_OTP).
SHOPEE_SANDBOX_MAIN_ACCOUNT=your_main_account_name_here:main
SHOPEE_SANDBOX_MAIN_PASSWORD=your_main_account_password_here
SHOPEE_SANDBOX_MAIN_ACCOUNT_ID=your_main_account_id_here
# Optional: user selected for the user suite (defaults to the grant's first user)
SHOPEE_SANDBOX_USER_ID=


# Production read-only Video user test: npm run test:live:video (the sandbox has no Video API).
# Requires a Video Management app and user grant; see docs/guides/user-authentication.md.
SHOPEE_USER_PARTNER_ID=
SHOPEE_USER_PARTNER_KEY=
SHOPEE_USER_ID=
SHOPEE_USER_ACCESS_TOKEN=
# Optional override, e.g. https://partner.test-stable.shopeemobile.com/api/v2
SHOPEE_USER_BASE_URL=
